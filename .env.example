# Environment
# ---------------------------------------------------------------------------
# STORAGE TODAY: app writes JSON under .data/ (no DB required for chat).
# Prisma schema is prepared for Postgres — set DATABASE_URL only when migrating.
# ---------------------------------------------------------------------------
DATABASE_URL=
# Example Postgres: postgresql://USER:PASSWORD@localhost:5432/nurjahon?schema=public
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Auth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# OAuth — only enable after creating real apps (no fake login)
# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client (Web application)
# OAuth consent screen → App name: set to "ChatGem AL" (Google login shows THIS, not NEXT_PUBLIC_APP_NAME)
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs:     http://localhost:3000/api/auth/callback/google
# Do NOT use Cursor Simple Browser for Google Sign-In (Error 400) — use Chrome/Edge.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
# Authorization callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple (prepared; not fully enabled yet)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# AI Providers (server-side only — NEVER put these in frontend code)
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Google Gemini (FREE tier, much better Tajik than the Groq models): https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Optional model override (default: gemini-flash-latest)
# GOOGLE_AI_MODEL=gemini-flash-latest
# Groq (FREE tier): https://console.groq.com/keys
GROQ_API_KEY=

# Voice Mode (speech-to-text + text-to-speech) — server-side only, see docs/VOICE.md.
# STT needs OPENAI_API_KEY or GROQ_API_KEY. Natural TTS needs OPENAI_API_KEY;
# without it the app speaks with the device's built-in voices.
# Order of STT providers: auto (OpenAI → Groq) | openai | groq
# VOICE_STT_PROVIDER=auto
# TTS: auto (OpenAI) | openai | browser (device voices only, no TTS cost)
# VOICE_TTS_PROVIDER=auto
# Models are tried left → right until one works:
# OPENAI_STT_MODELS=gpt-4o-mini-transcribe,gpt-4o-transcribe,whisper-1
# GROQ_STT_MODELS=whisper-large-v3-turbo,whisper-large-v3
# OPENAI_TTS_MODELS=gpt-4o-mini-tts,tts-1
# Force one voice for every language (default picks per language), e.g. alloy, nova, shimmer, coral:
# OPENAI_TTS_VOICE=

# Free image generation fallback when OpenAI images are unavailable (server-only secret key).
# Create an sk_ key at https://enter.pollinations.ai/keys — anonymous requests are refused (401/402).
POLLINATIONS_API_KEY=
# Optional with a key — stronger model for logos/text, e.g. zimage, seedream, gptimage (default: flux)
# POLLINATIONS_IMAGE_MODEL=flux

# Feature flags
AI_PROVIDERS_CONFIGURED=false
PAYMENTS_CONFIGURED=false
WEB_SEARCH_CONFIGURED=false
VOICE_PROVIDERS_CONFIGURED=false
IMAGE_PROVIDERS_CONFIGURED=false

# Lemon Squeezy (recommended if Stripe country not available, e.g. Tajikistan)
# 1) https://app.lemonsqueezy.com — create store + 2 subscription products (Pro $9, Business $19)
# 2) Settings → API → create key
# 3) Store settings → copy Store ID; each product → Variant ID
# 4) Webhooks → URL https://YOUR_DOMAIN/api/billing/lemon-webhook
#    Events: order_created, subscription_created, subscription_payment_success
#    Signing secret → LEMON_SQUEEZY_WEBHOOK_SECRET
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_VARIANT_PRO=
LEMON_SQUEEZY_VARIANT_BUSINESS=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Payments — Stripe (optional; many countries only)
# 1) Create account: https://dashboard.stripe.com/register
# 2) Developers → API keys → Secret key
# 3) Connect bank account in Stripe for payouts (money arrives there, not by typing your card into the app)
STRIPE_SECRET_KEY=
# Optional but recommended in production:
# stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Publishable key (only if you add Stripe Elements later)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Web search providers (optional)
TAVILY_API_KEY=
SERPER_API_KEY=
BING_SEARCH_API_KEY=

# Maps & Navigation — all read on the server only (no NEXT_PUBLIC_ prefix).
# The default stack needs no keys: OSM tiles + Nominatim (search) + Overpass (nearby)
# + OSRM (real walking/driving routes). Public servers are rate-limited — for
# production traffic point these at your own/self-hosted instances.
# Routing (OSRM, separate foot, bike and car graphs):
# OSRM_FOOT_URL=https://routing.openstreetmap.de/routed-foot
# OSRM_BIKE_URL=https://routing.openstreetmap.de/routed-bike
# OSRM_CAR_URL=https://routing.openstreetmap.de/routed-car
# Search autocomplete (Photon, typo-tolerant, multilingual):
# PHOTON_BASE_URL=https://photon.komoot.io
# Geocoding (Nominatim). A contact email is required by the public usage policy:
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# NOMINATIM_CONTACT_EMAIL=
# Nearby places (Overpass, comma-separated mirrors tried in parallel):
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter
# Public transit steps + live traffic: without this key the app honestly shows
# "transit data unavailable" and hides traffic (no fake congestion colours).
# Google Directions API server key (restrict it by IP in Google Cloud):
# GOOGLE_MAPS_SERVER_KEY=
# Tap-on-map addresses: "nominatim" (default, key-free) or "google" (needs the key above with
# the Geocoding API enabled; usually has more house numbers; Nominatim stays the fallback).
# MAPS_REVERSE_GEOCODER=nominatim
# Custom tiles:
# Default basemap: https://tile.openstreetmap.org/{z}/{x}/{y}.png (key-free). Override if needed;
# MAP_TILE_SUBDOMAINS only matters when the URL contains {s}.
# MAP_TILE_URL=
# MAP_TILE_SUBDOMAINS=abc
# MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap
# Optional dedicated dark basemap (without it dark mode filters the standard tiles):
# MAP_DARK_TILE_URL=
# MAP_DARK_TILE_ATTRIBUTION=
# MAP_DARK_TILE_SUBDOMAINS=abc

# Legal media search in chat ("Номи ин сурудро ёб", "Ин филмро ёб") — server only.
# Works without keys: iTunes Search (30 s previews, never downloadable), Wikipedia +
# Wikidata (films) and Wikimedia Commons (public-domain / CC audio and video, downloadable).
# Store country for iTunes results and Apple Music links:
# MEDIA_STORE_COUNTRY=us
# Jamendo (Creative Commons music; Download only where the artist allows it).
# Free client id: https://devportal.jamendo.com
# JAMENDO_CLIENT_ID=
# TMDB (film posters, runtime and "where to watch" links — never downloads).
# v3 API key or v4 read token: https://www.themoviedb.org/settings/api
# TMDB_API_KEY=
# TMDB_REGION=US

# App
NEXT_PUBLIC_APP_NAME=ChatGem
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admins (comma-separated). These emails get ADMIN / SUPER_ADMIN after login.
ADMIN_EMAILS=negmatovansori8@gmail.com,nurjahonismoilov531@gmail.com
