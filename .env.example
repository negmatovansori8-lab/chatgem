# Environment
# ---------------------------------------------------------------------------
# STORAGE TODAY: app writes JSON under .data/ (no DB required for chat).
# Prisma schema is prepared for Postgres — set DATABASE_URL only when migrating.
# ---------------------------------------------------------------------------
DATABASE_URL=
# Example Postgres: postgresql://USER:PASSWORD@localhost:5432/nurjahon?schema=public
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Auth
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# OAuth — only enable after creating real apps (no fake login)
# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client (Web application)
# Authorized JavaScript origins: http://localhost:3000
# Authorized redirect URIs:     http://localhost:3000/api/auth/callback/google
# Do NOT use Cursor Simple Browser for Google Sign-In (Error 400) — use Chrome/Edge.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers
# Authorization callback: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple (prepared; not fully enabled yet)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# AI Providers (server-side only — NEVER put these in frontend code)
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Google AI: https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=
# Groq (FREE tier): https://console.groq.com/keys
GROQ_API_KEY=

# Feature flags
AI_PROVIDERS_CONFIGURED=false
PAYMENTS_CONFIGURED=false
WEB_SEARCH_CONFIGURED=false
VOICE_PROVIDERS_CONFIGURED=false
IMAGE_PROVIDERS_CONFIGURED=false

# Payments — real charges via Stripe (required for Pro/Business money)
# 1) Create account: https://dashboard.stripe.com/register
# 2) Developers → API keys → Secret key
# 3) Connect bank account in Stripe for payouts (money arrives there, not by typing your card into the app)
STRIPE_SECRET_KEY=
# Optional but recommended in production:
# stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Publishable key (only if you add Stripe Elements later)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Web search providers (optional)
TAVILY_API_KEY=
SERPER_API_KEY=
BING_SEARCH_API_KEY=

# App
NEXT_PUBLIC_APP_NAME=NURJAHON AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admins (comma-separated). These emails get ADMIN / SUPER_ADMIN after login.
ADMIN_EMAILS=negmatovansori8@gmail.com,nurjahonismoilov531@gmail.com
